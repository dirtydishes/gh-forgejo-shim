#!/usr/bin/python3
"""Transparent `gh` wrapper that records how clients call gh.

Link it in as `gh` in a directory that comes before the real gh on the client's PATH:

    ln -s <checkout>/scripts/capture/gh-capture ~/.local/bin/gh

It runs the real gh (GH_CAPTURE_REAL, an absolute path, default /opt/homebrew/bin/gh) and appends
one JSON line per call to GH_CAPTURE_LOG (default ~/.gh-capture/calls.jsonl, owner-only; one that
others could read is kept aside as `calls.jsonl.exposed-…`, and a new one begun). Nothing about
the log can break a call: one that can't be written is skipped, saying so only on a terminal.

A record holds: time, the parent process chain (to tell clients apart), cwd, argv, selected env,
exit code (and the signal, if one killed gh), duration, stdout and stderr, and stdin when gh was
told to read it (`--body-file -`); other input stays unread by the wrapper. No credential is
stored: argv loses tokens, sensitive flag values and fields (`-f config[secret]=…`), `gh secret`
bodies and every field sent to a secret's or a variable's API path; output that can carry a token
(`auth token`, `--show-token`, `auth git-credential`, `config get`, `api` on token paths) is
stored only as its length; other output loses its tokens and credentials. The rules come from redact.py beside the script, which is why
it's linked rather than copied; without them nothing is recorded. The rest of a person's details
stay until redact.py runs on the log, before anything is committed.

When stdout is a terminal, it records the argv and execs gh, so interactive output doesn't change.
Otherwise gh writes stdout to a pipe, which keeps its non-TTY behaviour, and each chunk reaches the
caller as gh writes it (`gh pr checks --watch`), with a copy kept for the record. stderr goes the
same way, unless it's a terminal: then gh keeps it, and it isn't recorded. When gh exits leaving
something running that holds those pipes (an extension's background job), the wrapper exits with
gh, and a forked child passes on what that writes and records the call once the pipes close.
SIGINT, SIGTERM and SIGHUP go on to gh (a terminal's Ctrl-C, which gh gets too, only once), and
when a signal kills gh the wrapper dies of the same one. A stream the caller closed (`>&-`) goes
to /dev/null, as it would for gh. Python 3.9 compatible (macOS /usr/bin/python3).
"""
import fcntl
import json
import os
import re
import select
import signal
import stat
import subprocess
import sys
import threading
import time
import warnings

# The credential rules come from redact.py beside this script (scripts/capture), so install it as a
# link to the checkout's copy. Without them, or with a redact.py that's broken or lacks one, nothing
# is recorded and gh still runs.
RULES = ("ARMOR", "USERINFO", "TOKEN", "AUTHORIZATION", "TOKEN_HEADER", "COOKIE", "SECRET_ASSIGNMENT", "SENSITIVE_KEY",
         "json_spans", "dump_like")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import redact
    if not all(hasattr(redact, rule) for rule in RULES):
        raise ImportError("redact.py lacks rules gh-capture uses")
    # Keys whose values are credentials: redact.py's, and short words as a whole part of a name
    # (`deploy_pw`, `otp`, `config[auth]`, `signingKey`), so `author` and `keyword` stay. A field
    # gh sends may also be named for a key (`-f key=…`, `-f deploy_key=…`); an answer's `key` is
    # most often a license's, a cache's or a public key, and stays.
    PART = r"(?:\A|(?<=[_\-.\s\[])|(?<=[a-z])(?=[A-Z]))(?i:{})(?=\Z|[_\-.\s\]]|[A-Z])"
    SECRET_KEY = re.compile(rf"(?i:{redact.SENSITIVE_KEY.pattern.replace('(?i)', '', 1)}|jit_?config)|"
                            + PART.format("pw|otp|auth|authorization"))
    FIELD_KEY = re.compile(r"(?:\A|(?<=[_\-.\s\[])|(?<=[a-z])(?=[A-Z]))(?i:key)\Z")
    # A JSON string in text: closed, or cut short by a line break (which no JSON string holds) or
    # where the text stops. Every `"` starts one, so finding them all, one after another, takes one
    # pass however many quotes the text holds, and a stray quote throws off no more than its line.
    # A key is a closed one followed by a colon.
    LITERAL = re.compile(r'"((?:[^"\\\n]|\\.)*)("|\\?(?=\n)|\\?\Z)')
    COLON = re.compile(r"\s*:\s*")
    # What to look for in an array or an object.
    STRUCTURE = re.compile(r'["\[\]{}]')
except Exception:  # a broken redact.py may raise anything; it must not stop gh
    redact = None

REAL = os.environ.get("GH_CAPTURE_REAL", "/opt/homebrew/bin/gh")
LOG = os.path.expanduser(os.environ.get("GH_CAPTURE_LOG", "~/.gh-capture/calls.jsonl"))
ENV_KEYS = ("GH_HOST", "GH_REPO", "GH_PROMPT_DISABLED", "GH_NO_UPDATE_NOTIFIER", "GH_PAGER",
            "NO_COLOR", "CLICOLOR", "GIT_TERMINAL_PROMPT", "TERM")
SECRET_ENV = ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN")
MAX_STREAM = 256 * 1024
# What a caller sends to stop a call; each goes on to gh. Any other signal reaches gh only as the
# caller's process group gets it. A handler can't tell who sent a signal, and not forwarding would
# lose one sent to the wrapper alone (an app cancelling its call). So a SIGINT that may be a
# terminal's Ctrl-C, which gh gets too, as the wrapper is in the terminal's foreground group, goes
# on only after FORWARD_DELAY, and not once gh has exited of the first. Nor does gh get a process
# group of its own, which would take each signal once: a signal to the caller's group would then
# miss gh, so a timeout's SIGKILL would leave gh running, and Ctrl-Z stop only the wrapper.
FORWARDED = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
FORWARD_DELAY = 0.1
# gh flags with a sensitive word in their name that take no value.
VALUELESS_FLAGS = {"--with-token", "--show-token"}
# gh 2.103.3's own commands and their built-in aliases (`gh help`). Any other first word is an alias
# or an extension, `co` included since a user can redefine it, and may print anything, a token too
# (`gh alias set tok 'auth token'`), so only its output's length is kept; so is `extension exec`.
COMMANDS = {"accessibility", "actions", "agent-task", "alias", "api", "at", "attestation", "auth", "browse", "cache",
            "codespace", "completion", "config", "copilot", "credits", "cs", "discussion", "environment", "exit-codes",
            "ext", "extension", "extensions", "formatting", "gist", "gpg-key", "help", "issue", "label", "licenses",
            "mintty", "org", "pr", "preview", "project", "reference", "release", "repo", "ruleset", "run", "search",
            "secret", "skill", "skills", "ssh-key", "status", "telemetry", "variable", "version", "workflow"}
# Commands that check their writes to stdout, copying gh's answer out and failing when that fails
# (`gh api`, a diff, a run's logs, `release download -O -`). Others ignore a failed write.
CHECKED_WRITES = (["api"], ["pr", "diff"], ["run", "view"], ["run", "watch"], ["release", "download"])
# Flags whose value is no command word.
VALUE_FLAGS = {"-R", "--repo", "--hostname", "-H", "--header", "-f", "-F", "--field", "--raw-field", "-X", "--method",
               "--jq", "-q", "--template", "-t", "--input", "-p", "--preview", "--cache", "-o", "--org", "-e", "--env",
               "-a", "--app"}
# `gh api` paths that answer with a credential, and a `--jq` or `--template` that picks one out.
SECRET_PATH = re.compile(r"(?i)token|authorization|jitconfig|credential|secret|password")
# `gh api` paths whose fields and body are all values to keep: a secret's or a variable's
# (`-X PUT repos/o/r/actions/secrets/NAME -f data=…`, Forgejo's form).
SECRET_BODY_PATH = re.compile(SECRET_PATH.pattern + r"|variables")
# The flags whose value is a field.
FIELD_FLAGS = {"-f", "-F", "--field", "--raw-field"}
# An argument that may tell an alias or an extension to read stdin: `-`, a flag's value `-`
# (`--body-file=-`, `-F-`), or a field read from it (`-F body=@-`).
NAMES_STDIN = re.compile(r"(?:\A|=|\A-[A-Za-z])@?-\Z")
# gh 2.103.3's commands that read stdin for a lone `-` argument: an alias's expansion or file, a
# gist's file, a key.
STDIN_POSITIONAL = (["alias", "set"], ["alias", "import"], ["gist", "create"], ["gist", "new"], ["gist", "edit"],
                    ["ssh-key", "add"], ["gpg-key", "add"], ["repo", "deploy-key", "add"])
# A field gh sends, `NAME=VALUE` as its own argument or joined to `-f`, `-F`, `--field` or
# `--raw-field`, whose name may nest (`config[secret]`, `events[]`).
FIELD = re.compile(r"(--(?:raw-)?field=|-[fF]=?)?([^\s=\[\]]+(?:\[[^\]]*\])*)=(.*)", re.DOTALL)


def real_gh():
    """GH_CAPTURE_REAL resolved to the file it names, or None. An absolute path only, so PATH (which
    finds this wrapper first) never decides, and never this wrapper itself under another name (a
    symlink or a hard link), which would run itself until something stopped it."""
    if not os.path.isabs(REAL):
        return None
    try:
        path = os.path.realpath(REAL)
        found, own = os.stat(path), os.stat(os.path.realpath(__file__))
    except OSError:
        return None
    return None if (found.st_dev, found.st_ino) == (own.st_dev, own.st_ino) else path


def process_chain(limit=6):
    """The parent processes' commands, nearest first. Anything that stops the lookup, such as a
    system without ps, only cuts the chain short."""
    chain, pid = [], os.getppid()
    try:
        for _ in range(limit):
            if pid <= 1:
                break
            pid, command = parent(pid)
            chain.append(command)
    except Exception:  # the chain is a nicety; nothing about it may break the call
        pass
    return chain


def parent(pid):
    """(parent pid, command) of a process: from /proc on Linux, else from ps (macOS)."""
    if os.path.exists(f"/proc/{pid}/stat"):
        with open(f"/proc/{pid}/stat") as handle:
            status = handle.read()
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            command = handle.read().split(b"\0")[0].decode("utf-8", "replace")
        # The name sits in brackets and may hold spaces; the parent pid is the second field after.
        return int(status[status.rindex(")") + 2:].split()[1]), command or status[status.index("(") + 1:status.rindex(")")]
    out = subprocess.run(["/bin/ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    ppid, _, command = out.partition(" ")
    return int(ppid), command.strip()


def scrub(text):
    """Credentials out of text: a token, an Authorization or token header, a cookie, a `key=value`
    secret, a URL's password, a signature. Everything else stays for redact.py."""
    text = redact.ARMOR.sub(r"-----BEGIN \1-----<redacted>-----END \1-----", text)
    text = redact.USERINFO.sub(r"\1<redacted>@", text)
    text = redact.TOKEN.sub("<token>", text)
    text = redact.AUTHORIZATION.sub(r"\1<token>", text)
    text = redact.TOKEN_HEADER.sub(r"\1<token>", text)
    text = redact.COOKIE.sub(r"\1<redacted>", text)
    text = hide_values(LITERAL.sub(unescaped, text))
    return redact.SECRET_ASSIGNMENT.sub(r"\1<redacted>", text)


def hide_values(text):
    """Text whose sensitive JSON keys' values are hidden, wherever they sit (after `-i` headers, in
    a field's value): a string (`"token":"S"`), and every string value in an array or an object
    (`"tokens":["S"]`). One cut short where the output stops (cut at MAX_STREAM, or gh died writing
    it) is hidden to the end. Keys and empty values stay."""
    out, at = [], 0
    for key in LITERAL.finditer(text):
        colon = key.start() >= at and key.group(2) == '"' and COLON.match(text, key.end())
        if not colon or text[colon.end():colon.end() + 1] not in ('"', "[", "{") or not SECRET_KEY.search(key.group(1)):
            continue
        out.append(text[at:colon.end()])
        at, depth = colon.end(), 0
        while True:
            mark = STRUCTURE.search(text, at)
            if mark is None:
                break
            out.append(text[at:mark.start()])
            at = mark.end()
            if mark.group() != '"':
                depth += 1 if mark.group() in "[{" else -1
                out.append(mark.group())
            else:
                value = LITERAL.match(text, mark.start())
                kept = value.group(0) == '""' or depth and COLON.match(text, value.end())
                out.append(value.group(0) if kept else '"<redacted>"' if value.group(2) == '"' else '"<redacted>')
                at = value.end()
            if depth <= 0:
                break
    return "".join(out) + text[at:]


def unescaped(match):
    """A string in text holding escaped JSON (`"body":"{\\"token\\":\\"S\\"}"`), scrubbed as the text
    it holds and encoded again. Any other string stays."""
    body, closed = match.group(1), match.group(2) == '"'
    if '\\"' not in body:
        return match.group(0)
    try:
        inner = json.loads(f'"{body}"')
    except ValueError:
        return match.group(0)
    clean = scrub(inner)
    if clean == inner:
        return match.group(0)
    return json.dumps(clean, ensure_ascii=False)[:None if closed else -1]


def redact_argv(argv):
    """argv without its credentials: a sensitive flag's value (`--token X`), `gh secret`'s body,
    every field sent to a secret's or a variable's path, and whatever scrub() finds in any
    argument (`-H 'Authorization: token X'`, `-f token=X`)."""
    # `gh secret`, wherever gh's flags put the word: gh finds it past `--org o` or `-e prod`.
    secret_command = next((word for word in words(argv) if word in COMMANDS), None) == "secret"
    secret_body = secret_api(argv)
    out = []
    hide_next = False
    for index, arg in enumerate(argv):
        if hide_next:
            out.append("<redacted>")
            hide_next = False
            continue
        flag, equal, _ = arg.partition("=")
        sensitive = (flag.startswith("--") and bool(redact.SENSITIVE_KEY.search(flag)) and flag not in VALUELESS_FLAGS
                     or secret_command and flag in ("--body", "-b"))
        if sensitive:
            out.append(f"{flag}=<redacted>" if equal else arg)
            hide_next = not equal
        elif secret_command and arg.startswith("-b") and not arg.startswith("--") and len(arg) > 2:
            out.append("-b<redacted>")
        elif secret_field(arg) or secret_body and FIELD.fullmatch(arg) and (
                FIELD.fullmatch(arg).group(1) or index and argv[index - 1] in FIELD_FLAGS):
            prefix, name, _ = FIELD.fullmatch(arg).groups()
            out.append(f"{prefix or ''}{name}=<redacted>")
        else:
            out.append(scrub(arg))
    return out


def secret_api(argv):
    """Whether a call is `gh api` on a secret's or a variable's path, whose body is a value to keep."""
    command = words(argv)
    return command[:1] == ["api"] and any(SECRET_BODY_PATH.search(word) for word in command[1:])


def secret_field(arg):
    """Whether an argument is a field whose name, in any of its parts, is sensitive: the whole
    value goes, spaces and all (`-f 'config[secret]=a b'`)."""
    field = FIELD.fullmatch(arg)
    return bool(field) and any(SECRET_KEY.search(part) or FIELD_KEY.search(part)
                               for part in re.findall(r"[^\[\]]+", field.group(2)))


def input_kind(argv):
    """How to treat the caller's stdin. "record" passes it to gh through the wrapper, keeping a
    copy: only when it's no terminal and gh was told to read it (`--body-file -`, `--input -`), so
    input gh never asks for stays unread for whatever reads it next. "credential" leaves gh to read
    input that may be a credential (`auth login --with-token`, `auth git-credential`, `secret set`,
    a sensitive field, a token path, an alias or extension), recording only that there was some.
    None leaves stdin to gh, unrecorded."""
    named = stdin_args(argv)
    try:
        os.fstat(0)
    except OSError:  # stdin closed: os.isatty says only False
        return None
    if not named or os.isatty(0):
        return None
    if (words(argv)[:1] in (["auth"], ["secret"]) or secret_output(argv) or secret_api(argv)
            or any(secret_field(arg) for arg in named)):
        return "credential"
    return "record"


def stdin_args(argv):
    """The arguments that make gh 2.103.3 read stdin: a field read from it (`-F body=@-`, in `api`
    and `workflow run`), `--input -`, a file flag's `-` (`--body-file -`, `--notes-file=-`, `-F -`
    where `-F` is one, `-f -` for `secret set`'s and `variable set`'s `--env-file`), `--with-token`,
    and a lone `-` for the commands that read one. An alias or an extension may read any of them.
    A `-` gh uses as it is (`-f title=-`, `--body -`, `-t -`) reads nothing."""
    command = words(argv)
    if command and command[0] not in COMMANDS:
        return [arg for arg in argv if NAMES_STDIN.search(arg)]
    fields = command[:1] == ["api"] or command[:2] == ["workflow", "run"]
    file_flags = {"--input"} | ({"-f"} if command[:2] in (["secret", "set"], ["variable", "set"]) else set()) | (
        set() if fields else {"-F"})
    found = []
    for index, arg in enumerate(argv):
        previous = argv[index - 1] if index else ""
        flag, equal, value = arg.partition("=")
        field = FIELD.fullmatch(arg)
        if arg == "--with-token":
            found.append(arg)
        elif fields and field and field.group(3) == "@-" and (field.group(1) in ("-F", "-F=", "--field=") or
                                                             not field.group(1) and previous in ("-F", "--field")):
            found.append(arg)
        elif flag.startswith("--") and flag.endswith("-file") or flag in file_flags:
            if equal and value == "-":
                found.append(arg)
        elif arg in {short + "-" for short in file_flags if len(short) == 2}:
            found.append(arg)
        elif arg == "-":
            reads = command[:2] in STDIN_POSITIONAL or command[:3] in STDIN_POSITIONAL
            if (previous.startswith("--") and previous.endswith("-file") or previous in file_flags or
                    reads and not previous.startswith("-")):
                found.append(arg)
    return found


def words(argv):
    """argv's words, not its flags or their values: the command, its subcommands and arguments."""
    out, skip = [], False
    for arg in argv:
        if skip:
            skip = False
        elif arg.startswith("-"):
            skip = arg in VALUE_FLAGS
        else:
            out.append(arg)
    return out


def expressions(argv):
    """The values of `--jq`, `-q` and `--template` (and `-t`, outside `auth`), in every form gh
    takes: `-q EXPR`, `-q=EXPR`, `-qEXPR`, `--jq=EXPR`."""
    flags = ("--jq", "-q", "--template") + (() if "auth" in argv else ("-t",))
    found = []
    for index, arg in enumerate(argv):
        flag, equal, value = arg.partition("=")
        if flag in flags:
            found.append(value if equal else argv[index + 1] if index + 1 < len(argv) else "")
        elif arg[:2] in flags and len(arg) > 2 and not arg.startswith("--"):
            found.append(arg[2:])
    return found


def secret_output(argv):
    """Whether gh may print a token: `auth token` wherever its flags sit (`gh --hostname h auth
    token`), `auth` with `--show-token` in any form or `-t` alone or among short flags, `auth
    git-credential`, `config get` and `config list` (gh's config holds `oauth_token`), and `api`
    on a path about credentials (`…/registration-token`, `…/access_tokens`, `generate-jitconfig`),
    a `--jq` or `--template` that picks one out, and any alias or extension."""
    command = words(argv)
    if command and command[0] not in COMMANDS:
        return True
    if command[:1] in (["extension"], ["extensions"], ["ext"]) and command[1:2] == ["exec"]:
        return True
    if any(SECRET_KEY.search(expression) for expression in expressions(argv)):
        return True
    if "auth" in argv:
        shown = any(arg == "--show-token" or arg.startswith("--show-token=") or
                    re.fullmatch(r"-[A-Za-z]*t[A-Za-z]*", arg) for arg in argv)
        if "token" in argv or "git-credential" in argv or shown:
            return True
    if command[:1] == ["config"] and command[1:2] in (["get"], ["list"]):
        return True
    return command[:1] == ["api"] and any(SECRET_PATH.search(word) for word in command[1:])


def fake_token(argv):
    """Probe mode's fake token for `auth token` on a host listed in ~/.gh-capture/fake-token-hosts,
    the host given as `--hostname H`, `--hostname=H` or `-h H`; None otherwise, or if the list can't
    be read."""
    if words(argv)[:2] != ["auth", "token"]:
        return None
    host = None
    for index, arg in enumerate(argv):
        flag, equal, value = arg.partition("=")
        if flag in ("--hostname", "-h"):
            host = value if equal else argv[index + 1] if index + 1 < len(argv) else None
    try:
        with open(os.path.expanduser("~/.gh-capture/fake-token-hosts")) as handle:
            hosts = [line.strip() for line in handle if line.strip() and not line.startswith("#")]
    except (OSError, ValueError):  # unreadable, or not text
        return None
    return "gfjprobe_" + host.replace(".", "_") if host in hosts else None


class Pump:
    """Copies one of gh's pipes to ours as it arrives, keeping the first MAX_STREAM bytes."""

    def __init__(self, name, source, target, closes=None):
        self.name, self.source, self.target = name, source, target
        self.closes = closes  # the file behind target, to close at the end: gh's stdin
        self.kept = bytearray()
        self.total = 0
        self.writing = True  # passing output on: false once that has failed
        self.failed = None  # why passing output on failed, if it did
        self.done = False  # gh's pipe has closed, or the caller stopped reading
        self.thread = None

    def start(self, stop):
        self.thread = threading.Thread(target=self.run, args=(stop,), daemon=True)
        self.thread.start()

    def run(self, stop):
        """Until the pipe closes, or `stop` is set and the pipe has nothing to read."""
        while not self.done:
            if not select.select([self.source], [], [], 0.05)[0]:
                if stop.is_set():
                    return
                continue
            try:
                chunk = os.read(self.source.fileno(), 65536)
            except BlockingIOError:  # a caller's non-blocking stdin, read by another meanwhile
                continue
            if not chunk:
                break
            self.total += len(chunk)
            if len(self.kept) < MAX_STREAM:
                self.kept += chunk[:MAX_STREAM - len(self.kept)]
            while self.writing and chunk:
                try:
                    chunk = chunk[os.write(self.target, chunk):]
                except BlockingIOError:
                    # The caller's non-blocking pipe is full: wait for room, as gh itself would.
                    select.select([], [self.target], [])
                except BrokenPipeError:
                    # The caller stopped reading: so does the wrapper, and gh's next write fails
                    # as it would have without the wrapper.
                    self.writing, self.done = False, True
                except OSError as error:
                    # Anything else (a full disk, a read-only descriptor) loses the caller's copy,
                    # but gh's pipe keeps draining, so gh never blocks on it. The call fails only
                    # where gh's own failed write would have failed it (CHECKED_WRITES).
                    self.writing = False
                    self.failed = error.strerror or str(error)
        self.done = True
        self.source.close()
        if self.closes:  # gh's stdin: the end of its input
            self.closes.close()


def hand_on(pumps, then):
    """Fork a process to keep passing on what something gh left running writes to the pipes gh
    handed it, as the streams gh alone would have handed it, so the caller sees gh's exit when gh
    exits. The child calls `then` once the pipes close, and exits. True in the parent; False if
    the fork fails, and what's written later is then lost."""
    try:
        with warnings.catch_warnings():  # no thread is running, but nothing may reach stderr
            warnings.simplefilter("ignore")
            pid = os.fork()
    except OSError:
        return False
    if pid:
        return True
    try:
        # Like a pipe, the child lasts as long as the writers do, through a terminal's Ctrl-C or
        # hangup, and holds nothing else the caller gave the wrapper: not the stream whose pipe has
        # closed already, which `out=$(gh … 2>/dev/null)` would otherwise wait on.
        for number in (signal.SIGINT, signal.SIGHUP):
            signal.signal(number, signal.SIG_IGN)
        keep = {pump.target for pump in pumps} | {pump.source.fileno() for pump in pumps}
        for name in os.listdir("/dev/fd"):
            if int(name) not in keep:
                try:
                    os.close(int(name))
                except OSError:  # the listing's own descriptor, closed already
                    pass
        # SIGTERM, which has no gh left to go on to, stops the child, with what came so far recorded.
        def stopped(number, frame):
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            then()
            os._exit(0)

        signal.signal(signal.SIGTERM, stopped)
        never = threading.Event()
        for pump in pumps:
            pump.start(never)
        for pump in pumps:
            pump.thread.join()
        signal.signal(signal.SIGTERM, signal.SIG_IGN)  # the record is on its way
        then()
    finally:
        os._exit(0)


def text(pump):
    """Output as stored: its credentials scrubbed, the values under a JSON answer's sensitive keys
    hidden, and cut short past MAX_STREAM. Nothing without redact.py's rules."""
    if redact is None:
        return None
    if pump.total > MAX_STREAM:
        return {"truncated": True, "bytes": pump.total, "head": scrub(bytes(pump.kept).decode("utf-8", "replace"))}
    value = bytes(pump.kept).decode("utf-8", "replace")
    spans = redact.json_spans(value)
    if spans:
        out, last = [], 0
        for start, end, answer in spans:
            out += [value[last:start], redact.dump_like(secretless(answer), value[start:end])]
            last = end
        value = "".join(out) + value[last:]
    return scrub(value)


def secretless(value, hidden=False):
    """A JSON value without its credentials: every string under a sensitive key, at any depth, is
    hidden, and a string holding JSON (`"body":"{\\"token\\":…}"`) is judged as that JSON."""
    if isinstance(value, dict):
        return {key: secretless(item, hidden or bool(SECRET_KEY.search(key))) for key, item in value.items()}
    if isinstance(value, list):
        return [secretless(item, hidden) for item in value]
    if isinstance(value, str) and value:
        if hidden:
            return "<redacted>"
        if value.lstrip()[:1] in ("{", "["):
            try:
                inner = json.loads(value)
            except ValueError:
                return value
            clean = secretless(inner)
            return redact.dump_like(clean, value) if clean != inner else value
    return value


def foreground():
    """Whether the wrapper is in its terminal's foreground process group, which a Ctrl-C reaches."""
    try:
        terminal = os.open("/dev/tty", os.O_RDONLY | os.O_NOCTTY)
    except OSError:  # no controlling terminal
        return False
    try:
        return os.tcgetpgrp(terminal) == os.getpgrp()
    except OSError:
        return False
    finally:
        os.close(terminal)


def die_like(number):
    """Exit the way gh did when a signal killed it, so the caller sees the same death, not 128+N
    folded into an exit code (#197 defect 5)."""
    try:
        signal.signal(number, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_UNBLOCK, [number])
    except (OSError, ValueError):  # SIGKILL and SIGSTOP take no handler and no mask
        pass
    os.kill(os.getpid(), number)
    # Still here: the signal can't kill us. Exit as a shell reports it.
    sys.exit(128 + number)


def reopen_closed():
    """Point a stream the caller closed (`>&-`, `2>&-`) at /dev/null, as Go does for gh, so gh's
    output there goes nowhere and nothing fails, and none of the wrapper's own pipes takes its
    number. The names of those streams."""
    closed = []
    for number, name in ((1, "stdout"), (2, "stderr")):
        try:
            os.fstat(number)
        except OSError:
            null = os.open(os.devnull, os.O_WRONLY)
            if null != number:
                os.dup2(null, number)
                os.close(null)
            closed.append(name)
    return closed


def begin(argv, closed):
    """The record of a call before gh runs, or None: nothing about recording may stop the call
    (a deleted cwd, a closed stream, a redact.py that fails)."""
    if redact is None:
        return None
    try:
        return {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "chain": process_chain(),
            "cwd": cwd(),
            "argv": redact_argv(argv),
            "env": {k: os.environ[k] for k in ENV_KEYS if k in os.environ},
            "env_secrets_present": [k for k in SECRET_ENV if os.environ.get(k)],
            "stdin_tty": os.isatty(0),
            "stdout_tty": os.isatty(1),
            "stderr_tty": os.isatty(2),
            **({"closed": closed} if closed else {}),
        }
    except Exception:
        return None


def signal_name(number):
    """A signal's name, or its number for one without (Linux's real-time signals)."""
    try:
        return signal.Signals(number).name
    except ValueError:
        return f"signal {number}"


def same_place(first, second):
    """Whether gh's writes to two descriptors land in one stream, so one pipe for both keeps gh's
    order: the same pipe, socket or device, or a regular file both append to (`>>f 2>>f`) or opened
    once for both (`>f 2>&1`). A file opened twice (`>f 2>f`) has an offset for each, so its two
    streams overwrite each other, and stay apart as they would for gh."""
    try:
        one, other = os.fstat(first), os.fstat(second)
        if (one.st_dev, one.st_ino) != (other.st_dev, other.st_ino):
            return False
        if not stat.S_ISREG(one.st_mode):
            return True
        if all(fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_APPEND for fd in (first, second)):
            return True
        return shared_offset(first, second)
    except OSError:
        return False


def shared_offset(first, second):
    """Whether two descriptors share one open file: moving the first's offset moves the second's.
    The offset is put back at once, before gh starts."""
    where = os.lseek(first, 0, os.SEEK_CUR)
    if os.lseek(second, 0, os.SEEK_CUR) != where:
        return False
    os.lseek(first, where + 1, os.SEEK_SET)
    try:
        return os.lseek(second, 0, os.SEEK_CUR) == where + 1
    finally:
        os.lseek(first, where, os.SEEK_SET)


def cwd():
    try:
        return os.getcwd()
    except OSError:
        return None


def finish(record, argv, code, duration, pumps, stderr, stdin):
    """The record once gh is done, written; any failure only loses the record. `stderr` stands in
    for a stream no pump copied; `stdin` is the pump that passed the caller's input on, or what stands in for it."""
    if record is None:
        return
    try:
        record["duration_ms"] = round(duration * 1000)
        record["exit"] = code
        if code < 0:
            record["signal"] = signal_name(-code)
        failed = [pump.name for pump in pumps if pump.failed]
        if failed:
            record["forward_failed"] = failed
        for pump in pumps:
            record[pump.name] = {"redacted": True, "bytes": pump.total} if secret_output(argv) else text(pump)
        if stdin is not None:
            record["stdin"] = text(stdin) if isinstance(stdin, Pump) else stdin
        if stderr:
            record["stderr"] = stderr
    except Exception:
        return
    write(record)


def write(record):
    """Append one record, owner-only. A log that can't be written never stops the gh call; on a
    terminal it says so. Only a plain file of ours is written, never through a symlink. One others
    could read may already be open to them, which narrowing it wouldn't undo: it's narrowed, kept
    under another name, and a fresh log started, whose first record names the old one."""
    if record is None:
        return
    try:
        directory = os.path.dirname(LOG)
        if directory:
            os.makedirs(directory, mode=0o700, exist_ok=True)
        descriptor = open_log()
        if os.fstat(descriptor).st_mode & 0o077:
            aside = move_aside(descriptor)
            descriptor = open_log(fresh=True)
            record["log_moved_aside"] = os.path.basename(aside)
            if os.isatty(2):
                os.write(2, f"gh-capture: others could read {LOG}; kept as {aside}, and a new log begun\n".encode())
        with os.fdopen(descriptor, "a") as handle:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    except Exception as error:  # nothing about the log may break the call
        if os.isatty(2):
            os.write(2, f"gh-capture: call not recorded: {error}\n".encode())


def open_log(fresh=False):
    """The log, open to append: a plain file of ours, never through a symlink, and with `fresh`, a
    file this call created (O_EXCL), so it's owner-only."""
    # O_NONBLOCK: a FIFO without a reader fails here instead of holding the call.
    flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | (os.O_EXCL if fresh else 0)
    descriptor = os.open(LOG, flags, 0o600)
    found = os.fstat(descriptor)
    if not stat.S_ISREG(found.st_mode) or found.st_uid != os.geteuid():
        os.close(descriptor)
        raise OSError(f"{LOG} is not a plain file of ours")
    return descriptor


def move_aside(descriptor):
    """Narrow the open log to its owner, rename it aside, and close it: the new name. Only if the
    log's path still names that file, so a log another call began meanwhile stays."""
    try:
        os.fchmod(descriptor, 0o600)
        found, current = os.fstat(descriptor), os.stat(LOG, follow_symlinks=False)
        aside = f"{LOG}.exposed-{time.strftime('%Y%m%dT%H%M%S')}-{os.getpid()}"
        if (found.st_dev, found.st_ino) != (current.st_dev, current.st_ino):
            raise OSError(f"{LOG} changed while it was being moved aside")
        os.rename(LOG, aside)
        return aside
    finally:
        os.close(descriptor)


def main():
    argv = sys.argv[1:]
    closed = reopen_closed()
    real = real_gh()
    if real is None:
        # As a shell answers for a command it can't run.
        try:
            os.write(2, f"gh-capture: GH_CAPTURE_REAL must be an absolute path to the real gh, not this wrapper: {REAL}\n"
                     .encode())
        except OSError:
            pass
        sys.exit(127)
    record = begin(argv, closed)
    fake = fake_token(argv)
    if fake:
        # Probe mode: answer `auth token --hostname H` for hosts listed in ~/.gh-capture/fake-token-hosts
        # so we can see what a client does next with a non-GitHub host.
        if record is not None:
            record.update({"faked": True, "exit": 0, "stdout": {"redacted": True, "bytes": len(fake) + 1}})
        write(record)
        try:
            os.write(1, (fake + "\n").encode())
        except OSError:
            pass
        sys.exit(0)

    if os.isatty(1):
        write(record)
        os.execv(real, [real] + argv)

    # A caller's signal goes on to gh, which decides what to do with it; one that arrives before gh
    # starts waits for it. Signals the caller left ignored stay ignored.
    child = []

    def forward(number, frame):
        if not child:
            waiting.append(number)
        elif number == signal.SIGINT and foreground():
            later = threading.Timer(FORWARD_DELAY, send, (number,))
            later.daemon = True
            later.start()
        else:
            send(number)

    def send(number):
        try:
            child[0].send_signal(number)  # nothing, once gh has exited
        except ProcessLookupError:
            pass

    waiting = []
    for number in FORWARDED:
        if signal.getsignal(number) is not signal.SIG_IGN:
            signal.signal(number, forward)
    start = time.time()
    # close_fds=False: gh keeps the files its caller opened for it, such as `--body-file <(...)`.
    # A terminal stderr stays gh's own, so its colour, progress and prompts don't change, and isn't
    # recorded. A caller that sends both streams to one place (`2>&1`) gets them through one pipe,
    # in gh's own order.
    terminal = os.isatty(2)
    merged = not terminal and same_place(1, 2)
    kind = input_kind(argv)
    proc = subprocess.Popen([real] + argv, stdin=subprocess.PIPE if kind == "record" else None, stdout=subprocess.PIPE,
                            stderr=None if terminal else subprocess.STDOUT if merged else subprocess.PIPE, close_fds=False)
    child.append(proc)
    for number in waiting:
        proc.send_signal(number)
    pumps = [Pump("stdout", proc.stdout, 1)] + ([] if merged or terminal else [Pump("stderr", proc.stderr, 2)])
    # Pass gh's output on until gh exits and its pipes have nothing left to read. Something gh left
    # running (an extension's background job, a browser) may hold them open longer: a forked child
    # then passes on the rest, and writes the record when they close.
    # gh's stdin closes when the caller's input ends, or when gh stops reading.
    feed = [Pump("stdin", os.fdopen(0, "rb", closefd=False), proc.stdin.fileno(), closes=proc.stdin)] if proc.stdin else []
    stop = threading.Event()
    for pump in pumps + feed:
        pump.start(stop)
    code = proc.wait()
    duration = time.time() - start
    stop.set()
    for pump in pumps + feed:
        pump.thread.join()
    for pump in feed:
        if not pump.done:
            pump.closes.close()
    stdin = feed[0] if feed else {"redacted": True} if kind == "credential" else None
    stderr = {"terminal": True} if terminal else {"merged_into_stdout": True} if merged else None
    left = [pump for pump in pumps if not pump.done]
    if not (left and hand_on(left, lambda: finish(record, argv, code, duration, pumps, stderr, stdin))):
        finish(record, argv, code, duration, pumps, stderr, stdin)
    if code < 0:
        die_like(-code)
    # A failed write to the caller fails the call only where it would have failed gh's.
    command = words(argv)
    failed = pumps[0].failed if any(command[:len(checked)] == checked for checked in CHECKED_WRITES) else None
    if failed and not code:
        try:
            os.write(2, f"gh-capture: stdout: {failed}\n".encode())
        except OSError:
            pass
    sys.exit(code or (1 if failed else 0))


if __name__ == "__main__":
    main()
