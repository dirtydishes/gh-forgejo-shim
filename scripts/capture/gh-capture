#!/usr/bin/python3
"""Transparent `gh` wrapper that records how clients call gh.

Install it as `gh` in a directory that comes before the real gh on the client's PATH. It runs the real
gh (GH_CAPTURE_REAL, default /opt/homebrew/bin/gh) and appends one JSON line per call to
GH_CAPTURE_LOG (default ~/.gh-capture/calls.jsonl).

A record holds: time, the parent process chain (to tell clients apart), cwd, argv, selected env, exit
code, duration, and stdout and stderr. Output that can carry a token (`auth token`, `--show-token`)
is never stored, only its length.

When stdout is a terminal, it records the argv and execs gh, so interactive output doesn't change.
Otherwise it buffers stdout and stderr and replays them after gh exits, which keeps gh's non-TTY
behavior. Python 3.9 compatible (macOS /usr/bin/python3).
"""
import json
import os
import subprocess
import sys
import time

# The credential rules come from redact.py beside this script (scripts/capture), so install it as a
# link to the checkout's copy. Without them nothing is recorded.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import redact
except ImportError:
    redact = None

REAL = os.environ.get("GH_CAPTURE_REAL", "/opt/homebrew/bin/gh")
LOG = os.path.expanduser(os.environ.get("GH_CAPTURE_LOG", "~/.gh-capture/calls.jsonl"))
ENV_KEYS = ("GH_HOST", "GH_REPO", "GH_PROMPT_DISABLED", "GH_NO_UPDATE_NOTIFIER", "GH_PAGER",
            "NO_COLOR", "CLICOLOR", "GIT_TERMINAL_PROMPT", "TERM")
SECRET_ENV = ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN")
MAX_STREAM = 256 * 1024
# gh flags with a sensitive word in their name that take no value.
VALUELESS_FLAGS = {"--with-token", "--show-token"}


def process_chain(limit=6):
    chain, pid = [], os.getppid()
    for _ in range(limit):
        if pid <= 1:
            break
        out = subprocess.run(["/bin/ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, _, comm = out.partition(" ")
        chain.append(comm.strip())
        pid = int(ppid)
    return chain


def scrub(text):
    """Credentials out of text: a token, an Authorization or token header, a cookie, a `key=value`
    secret, a URL's password, a signature. Everything else stays for redact.py."""
    text = redact.ARMOR.sub(r"-----BEGIN \1-----<redacted>-----END \1-----", text)
    text = redact.USERINFO.sub(r"\1<redacted>@", text)
    text = redact.TOKEN.sub("<token>", text)
    text = redact.AUTHORIZATION.sub(r"\1<token>", text)
    text = redact.TOKEN_HEADER.sub(r"\1<token>", text)
    text = redact.COOKIE.sub(r"\1<redacted>", text)
    return redact.SECRET_ASSIGNMENT.sub(r"\1<redacted>", text)


def redact_argv(argv):
    """argv without its credentials: a sensitive flag's value (`--token X`), `gh secret`'s body,
    and whatever scrub() finds in any argument (`-H 'Authorization: token X'`, `-f token=X`)."""
    secret_command = "secret" in argv
    out = []
    hide_next = False
    for arg in argv:
        if hide_next:
            out.append("<redacted>")
            hide_next = False
            continue
        flag, equal, _ = arg.partition("=")
        sensitive = (flag.startswith("--") and bool(redact.SENSITIVE_KEY.search(flag)) and flag not in VALUELESS_FLAGS
                     or secret_command and flag in ("--body", "-b"))
        if sensitive:
            out.append(f"{flag}=<redacted>" if equal else arg)
            hide_next = not equal
        elif secret_command and arg.startswith("-b") and not arg.startswith("--") and len(arg) > 2:
            out.append("-b<redacted>")
        else:
            out.append(scrub(arg))
    return out


def secret_output(argv):
    words = [a for a in argv if not a.startswith("-")]
    return words[:2] == ["auth", "token"] or "--show-token" in argv or "-t" in argv and "auth" in words


def fake_token(argv):
    words = [a for a in argv if not a.startswith("-")]
    if words[:2] != ["auth", "token"] or "--hostname" not in argv:
        return None
    i = argv.index("--hostname")
    host = argv[i + 1] if i + 1 < len(argv) else ""
    path = os.path.expanduser("~/.gh-capture/fake-token-hosts")
    if not os.path.exists(path):
        return None
    hosts = [line.strip() for line in open(path) if line.strip() and not line.startswith("#")]
    return "gfjprobe_" + host.replace(".", "_") if host in hosts else None


def text(data):
    if len(data) > MAX_STREAM:
        return {"truncated": True, "bytes": len(data), "head": data[:MAX_STREAM].decode("utf-8", "replace")}
    return data.decode("utf-8", "replace")


def write(record):
    """Append one record, owner-only. A log that can't be written never stops the gh call; on a
    terminal it says so."""
    try:
        if redact is None:
            raise RuntimeError("redact.py isn't beside gh-capture, so its credential rules aren't either")
        directory = os.path.dirname(LOG)
        if directory:
            os.makedirs(directory, mode=0o700, exist_ok=True)
        with os.fdopen(os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600), "a") as handle:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    except Exception as error:  # nothing about the log may break the call
        if sys.stderr.isatty():
            print(f"gh-capture: call not recorded: {error}", file=sys.stderr)


def main():
    argv = sys.argv[1:]
    record = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "chain": process_chain(),
        "cwd": os.getcwd(),
        "argv": redact_argv(argv) if redact else None,
        "env": {k: os.environ[k] for k in ENV_KEYS if k in os.environ},
        "env_secrets_present": [k for k in SECRET_ENV if os.environ.get(k)],
        "stdin_tty": sys.stdin.isatty(),
        "stdout_tty": sys.stdout.isatty(),
    }
    fake = fake_token(argv)
    if fake:
        # Probe mode: answer `auth token --hostname H` for hosts listed in ~/.gh-capture/fake-token-hosts
        # so we can see what a client does next with a non-GitHub host.
        record.update({"faked": True, "exit": 0, "stdout": {"redacted": True, "bytes": len(fake) + 1}})
        write(record)
        print(fake)
        sys.exit(0)

    if sys.stdout.isatty():
        write(record)
        os.execv(REAL, [REAL] + argv)

    start = time.time()
    proc = subprocess.run([REAL] + argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    record["duration_ms"] = round((time.time() - start) * 1000)
    record["exit"] = proc.returncode
    if secret_output(argv):
        record["stdout"] = {"redacted": True, "bytes": len(proc.stdout)}
        record["stderr"] = {"redacted": True, "bytes": len(proc.stderr)}
    else:
        record["stdout"] = text(proc.stdout)
        record["stderr"] = text(proc.stderr)
    write(record)
    sys.stdout.buffer.write(proc.stdout)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(proc.stderr)
    sys.stderr.buffer.flush()
    sys.exit(proc.returncode)


if __name__ == "__main__":
    main()
