{
  "id": "twin-pr-merge-wrong-head",
  "kind": "twin",
  "repo": "dirtydishes/gfj-oracle",
  "setup": {
    "branch": "twin/pr-merge-wrong-head",
    "pr": true,
    "base": true
  },
  "argv": [
    "pr",
    "merge",
    "{pr}",
    "--merge",
    "--match-head-commit",
    "0000000000000000000000000000000000000000"
  ],
  "expect": {
    "exit": 1,
    "stdout": "",
    "stderr": "GraphQL: Head branch was modified\\. Review and try the merge again\\. \\(mergePullRequest\\)\\n"
  },
  "state": [
    {
      "path": "pulls/{pr}",
      "fields": {
        "state": "open",
        "merged": false
      }
    }
  ],
  "normalize": []
}
