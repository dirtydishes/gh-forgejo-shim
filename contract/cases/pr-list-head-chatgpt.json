{
  "id": "pr-list-head-chatgpt",
  "argv": [
    "pr",
    "list",
    "--head",
    "s/pass",
    "--author",
    "@me",
    "--state",
    "all",
    "--json",
    "number,url,state,headRefName",
    "--repo",
    "forge.test/dirtydishes/gfj-oracle"
  ],
  "repo": "dirtydishes/gfj-oracle",
  "pr": 1,
  "normalize": [
    "host",
    "pr_urls",
    "json"
  ],
  "normalize_reason": {
    "json": "JSON object order and whitespace do not change the returned field values; array order stays significant."
  },
  "oracle": {
    "exit": 0,
    "stdout": "[{\"headRefName\":\"s/pass\",\"number\":1,\"state\":\"OPEN\",\"url\":\"https://github.com/dirtydishes/gfj-oracle/pull/1\"}]\n",
    "stderr": ""
  }
}
