{
  "id": "twin-run-list-own-branch",
  "kind": "twin",
  "repo": "dirtydishes/gfj-oracle",
  "setup": {
    "branch": "twin/run-list",
    "workflow": true
  },
  "argv": [
    "run",
    "list",
    "--branch",
    "{branch}",
    "--status",
    "queued",
    "--event",
    "push",
    "--limit",
    "5",
    "--json",
    "status,conclusion,event,headBranch,workflowName,databaseId"
  ],
  "expect": {
    "exit": 0,
    "stdout": "\\[\\{\"conclusion\":\"\",\"databaseId\":{run},\"event\":\"push\",\"headBranch\":\"twin/run\\-list\",\"status\":\"queued\",\"workflowName\":\"twin\"\\}\\]\\\n",
    "stderr": ""
  },
  "state": [],
  "normalize": []
}
