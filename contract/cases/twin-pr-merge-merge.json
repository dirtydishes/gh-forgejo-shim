{
  "id": "twin-pr-merge-merge",
  "kind": "twin",
  "repo": "dirtydishes/gfj-oracle",
  "setup": {
    "branch": "twin/pr-merge-merge",
    "pr": true,
    "base": true
  },
  "argv": [
    "pr",
    "merge",
    "{pr}",
    "--merge"
  ],
  "expect": {
    "exit": 0,
    "stdout": "",
    "stderr": ""
  },
  "state": [
    {
      "path": "pulls/{pr}",
      "fields": {
        "state": "closed",
        "merged": true
      }
    }
  ],
  "normalize": []
}
