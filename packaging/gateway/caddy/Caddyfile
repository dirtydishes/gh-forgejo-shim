# The forge's site with the gateway mounted. Caddy passes the client's Host through by default.
# Set the three values below, or export FORGE_SITE, FGA_UPSTREAM and FORGEJO_UPSTREAM.
{$FORGE_SITE:forge.example.com} {
	handle /api/v3/* {
		reverse_proxy {$FGA_UPSTREAM:127.0.0.1:8080}
	}
	handle /api/graphql {
		reverse_proxy {$FGA_UPSTREAM:127.0.0.1:8080}
	}
	# gh and ChatGPT link pull requests as /{owner}/{repo}/pull/{n}; the gateway redirects them.
	@pull_link path_regexp ^/[^/]+/[^/]+/pull/[0-9]+(/.*)?$
	handle @pull_link {
		reverse_proxy {$FGA_UPSTREAM:127.0.0.1:8080}
	}
	handle {
		reverse_proxy {$FORGEJO_UPSTREAM:127.0.0.1:3000}
	}
}
